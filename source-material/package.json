{
  "name": "framed-art-visualiser-poc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "asset:prepare": "node tools/asset-generator/index.mjs",
    "spin:mainline": "node tools/mainline-spin-importer/index.mjs",
    "import:centrado": ".venv-sam2/bin/python tools/centrado-importer/import.py",
    "batch:centrado": ".venv-sam2/bin/python tools/centrado-importer/batch_import.py && node tools/validate-moulding-assets.mjs",
    "batch:mainline": "node tools/mainline-batch-importer/index.mjs && node tools/mainline-batch-importer/build-catalog-module.mjs && .venv/bin/python tools/mainline-profile-analyser/build_mainline_multiframe_material.py && node tools/validate-moulding-assets.mjs",
    "batch:mainline:fetch": "node tools/mainline-batch-importer/index.mjs",
    "materials:mainline": ".venv/bin/python tools/mainline-profile-analyser/build_mainline_multiframe_material.py",
    "materials:pilot-v3": ".venv/bin/python tools/moulding-material-pilot/build_v3.py",
    "materials:quality": ".venv/bin/python tools/moulding-material-pilot/quality_pipeline.py",
    "validate:moulding-assets": "node tools/validate-moulding-assets.mjs",
    "catalog:mainline": "node tools/mainline-batch-importer/build-catalog-module.mjs",
    "analyse:mainline-profile": "python3 tools/mainline-profile-analyser/analyse.py",
    "parse:mainline-spec": "python3 tools/mainline-profile-analyser/mainline_spec_parser.py",
    "extract:mainline-profile": "python3 tools/mainline-profile-analyser/extract_auto_profile.py",
    "extract:mainline-simple-profile": "python3 tools/mainline-profile-analyser/extract_simple_spin_profile.py",
    "pilot:mainline-sections": ".venv/bin/python tools/mainline-profile-analyser/section_profile_pilot.py",
    "benchmark:sam2-sections": ".venv-sam2/bin/python tools/mainline-profile-analyser/sam2_section_benchmark.py",
    "benchmark:sam2-tiny-sections": ".venv-sam2/bin/python tools/mainline-profile-analyser/sam2_section_benchmark.py --model .model-cache/sam2.1-hiera-tiny",
    "review:mainline-profiles": "node tools/mainline-profile-analyser/build_review_index.mjs",
    "import:mainline-catalogue-pilot": "/Users/stephenorawe/.cache/codex-runtimes/codex-primary-runtime/dependencies/python/bin/python3 tools/mainline-catalogue-importer/import_catalogue_panels.py --pdf source-material/mainline/ml_catalogue.pdf --output source-material/mainline/catalogue-profiles --pdftoppm /Users/stephenorawe/.cache/codex-runtimes/codex-primary-runtime/dependencies/native/poppler/poppler/bin/pdftoppm --catalog-json src/mouldings/invoiceMouldings.json",
    "extract:mainline-catalogue-pilot": ".venv/bin/python tools/mainline-catalogue-importer/extract_profiles.py --root source-material/mainline/catalogue-profiles --public public/assets/mouldings --typescript-json src/mouldings/mainlineCatalogueProfiles.json",
    "batch:mainline-catalogue": "npm run import:mainline-catalogue-pilot && npm run extract:mainline-catalogue-pilot",
    "extract:mainline-gemma-profile": "python3 tools/mainline-profile-analyser/extract_gemma_profile.py",
    "build:mainline-trace-editors": "node tools/mainline-profile-analyser/build_manual_trace_editors.mjs",
    "test:profile-pipeline": "python3 tools/mainline-profile-analyser/test_profile_pipeline.py",
    "test:geometry": "node tools/test-profile-geometry.mjs",
    "calibrate:stock-room": ".venv-sam2/bin/python tools/room-calibrator/analyse_room.py --image source-material/rooms/stock-pilot/room.jpg --output public/assets/rooms/stock-pilot/calibration --wall-left 0.05 --wall-top 0.25 --wall-right 0.40 --wall-bottom 0.74 --quad-tl-x 0.08 --quad-tl-y 0.34 --quad-tr-x 0.35 --quad-tr-y 0.39 --quad-br-x 0.35 --quad-br-y 0.69 --quad-bl-x 0.08 --quad-bl-y 0.78",
    "room:enhance": ".venv-comfy/bin/python tools/ai-room-enhancer/run_workflow.py",
    "room:enhance:validate": ".venv-comfy/bin/python tools/ai-room-enhancer/validate_output.py"
  },
  "dependencies": {
    "@astrojs/react": "latest",
    "@react-three/drei": "latest",
    "@react-three/fiber": "latest",
    "astro": "latest",
    "react": "latest",
    "react-dom": "latest",
    "three": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "playwright": "^1.62.1",
    "typescript": "latest"
  }
}
